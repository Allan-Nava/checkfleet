---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-rolled sitemap: the site ships a custom in-repo theme with no third-party
  gems, so it lists pages instead of pulling in jekyll-sitemap. Any page with a
  `title` is listed; opt a page out with `sitemap: false` in its front matter.

  No <lastmod>: Jekyll has no accurate per-page modification date without a
  plugin, and search engines ignore (or distrust) a lastmod that is really the
  build timestamp.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.title" -%}
{%- for p in pages -%}
{%- unless p.sitemap == false %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
  </url>
{%- endunless -%}
{%- endfor %}
</urlset>
