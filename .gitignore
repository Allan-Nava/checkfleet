# Built binary at the repo root only — anchored with a leading slash so it does
# NOT also match the cmd/checkfleet/ package directory.
/checkfleet
# goreleaser output at the repo root only — anchored so it does NOT match the
# desktop frontend's committed sources under desktop/frontend/dist/.
/dist/
.DS_Store

# Jekyll docs site (built by .github/workflows/pages.yml).
docs/_site/
docs/.jekyll-cache/
docs/Gemfile.lock
cover.out

# desktop app run-history files written next to a config
.*.history.jsonl

# node_modules from running the frontend linters locally (CI installs them
# fresh with --no-save; they must never be committed). See desktop-test.yml.
node_modules/

# Per-developer Claude Code permissions — machine-local, never shared.
.claude/settings.local.json

# graphify knowledge graph: derived from the sources, rebuilt with
